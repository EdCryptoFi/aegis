'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { getAllAgents, AgentInfo, formatVolume } from '../lib/sdk';
import Navbar, { MobileNav } from '../components/Navbar';
import { StatCard, StatsGrid } from '../components/StatsGrid';
import { AgentListSkeleton } from '../components/Skeleton';

export default function Home() {
  const [agents, setAgents] = useState<AgentInfo[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadAgents();
  }, []);

  async function loadAgents() {
    try {
      const data = await getAllAgents();
      const sorted = data
        .sort((a, b) => b.reputation.uptimeScore - a.reputation.uptimeScore)
        .slice(0, 5);
      setAgents(sorted);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  }

  return (
    <main className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-3 sm:px-4 py-6 sm:py-12 flex flex-col items-center">
      <Navbar />
      <div className="pb-20 md:pb-0" />
          <header className="text-center mb-10">
            <h1 className="text-5xl font-extrabold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent mb-3">
              Aegis
            </h1>
            <p className="text-slate-400 text-lg">Trust is not asked. It's proven. On-chain.</p>
          </header>

          <section className="flex flex-wrap gap-3 justify-center mb-8">
            <Link href="/agents" className="flex items-center gap-2 px-5 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200 hover:-translate-y-0.5">
              <span>🤖</span> Use um Agente
            </Link>
            <Link href="/architecture" className="flex items-center gap-2 px-5 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200 hover:-translate-y-0.5">
              <span>⚙️</span> Como Funciona
            </Link>
            <Link href="/badges" className="flex items-center gap-2 px-5 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200 hover:-translate-y-0.5">
              <span>🏅</span> Adquira sua Badge
            </Link>
            <Link href="/developer" className="flex items-center gap-2 px-5 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200 hover:-translate-y-0.5">
              <span>🚀</span> Deploy seu Agente
            </Link>
            <Link href="/docs" className="flex items-center gap-2 px-5 py-3 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200 hover:-translate-y-0.5">
              <span>📖</span> Documentação
            </Link>
          </section>

          <section className="flex gap-3 w-full max-w-lg mb-10">
            <input
              type="text"
              placeholder="Buscar agente por endereço (0x...)"
              id="agent-address"
              className="flex-1 px-4 py-3.5 bg-slate-800/80 border border-slate-700 rounded-xl text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
              onKeyDown={(e) => {
                if (e.key === 'Enter') {
                  const input = e.currentTarget as HTMLInputElement;
                  if (input.value) window.location.href = `/agent/${input.value}`;
                }
              }}
            />
            <button onClick={() => {
              const input = document.getElementById('agent-address') as HTMLInputElement;
              if (input.value) window.location.href = `/agent/${input.value}`;
            }}
            className="px-6 py-3.5 bg-gradient-to-r from-indigo-500 to-purple-600 border-none rounded-xl text-white text-sm font-semibold cursor-pointer hover:opacity-90 transition-opacity">
              Buscar
            </button>
          </section>

          <section className="demo">
            <h2>Check Agent Reputation</h2>
            <p>Enter an agent address to check their reputation:</p>
            <div className="input-group">
              <input
                type="text"
                placeholder="0x..."
                id="agent-address"
              />
              <button onClick={() => {
                const input = document.getElementById('agent-address') as HTMLInputElement;
                const address = input.value;
                if (address) {
                  window.location.href = `/agent/${address}`;
                }
              }}>
                Check Reputation
              </button>
            </div>
            <div className="demo-agents">
              <span className="demo-label">Demo:</span>
              <button className="demo-btn" onClick={() => { window.location.href = '/agent/0x4cd8be48b4e1e0b1bdf01e93fedeac7de29f350b8ea1085367cc9d91367bfefc'; }}>
                AlphaTrader
              </button>
              <button className="demo-btn" onClick={() => { window.location.href = '/agent/0xabeddc0a2835b6db914b4b06eb246f643076960bdc8bffc2d9ff120abda90dec'; }}>
                BetaBot
              </button>
              <button className="demo-btn danger" onClick={() => { window.location.href = '/agent/0xb3fa170083a4bbe952a83147ed3839e75ba008558f8f017aee58c9bc89c9ffb6'; }}>
                GammaScam
              </button>
            </div>
          </section>

          <section className="featured">
            <h2>Top Agents</h2>
            <div className="agents-grid">
              {loading ? (
                <p className="loading">Carregando...</p>
              ) : agents.length > 0 ? (
                agents.map((agent) => (
                  <Link key={agent.objectId} href={`/agent/${agent.objectId}`} className="agent-card">
                    <div className="agent-header">
                      <span className="agent-name">
                        {agent.reputation.agentId.slice(0, 8)}...{agent.reputation.agentId.slice(-4)}
                      </span>
                      <span className={`badge ${agent.stats.trustLevel.toLowerCase()}`}>
                        {agent.stats.trustLevel === 'High' ? '🏅' : agent.stats.trustLevel === 'Medium' ? '🥈' : agent.stats.trustLevel === 'Flagged' ? '⚠️' : '❌'}
                      </span>
                    </div>
                    <div className="agent-stats">
                      <div className="stat">
                        <span className="value">{agent.reputation.uptimeScore}%</span>
                        <span className="label">Uptime</span>
                      </div>
                      <div className="stat">
                        <span className="value">{formatVolume(agent.reputation.totalVolume)}</span>
                        <span className="label">Volume</span>
                      </div>
                      <div className="stat">
                        <span className="value">{agent.reputation.totalExecutions}</span>
                        <span className="label">Exec</span>
                      </div>
                    </div>
                  </Link>
                ))
              ) : (
                <Link href="/developer" className="add-agent-card">
                  <span className="plus">+</span>
                  <span>Add seu agente</span>
                </Link>
              )}
            </div>
          </section>

          <section className="w-full max-w-lg">
            <StatsGrid stats={[
              { label: 'Total Agents', value: agents.length, icon: '🤖', color: 'indigo' },
              { label: 'Active Badges', value: '-', icon: '🏅', color: 'purple' },
              { label: 'Total Volume', value: '-', icon: '💰', color: 'green' },
              { label: 'Testnet', value: 'Live', icon: '🔗', color: 'yellow' },
            ]} />
          </section>

          <footer>
            <p>Built for Sui Overflow 2026</p>
            <p className="footer-links">
              <Link href="/docs">Docs</Link> | <Link href="/docs/terms">Terms</Link>
            </p>
          </footer>

          <style jsx>{`
            .container {
              min-height: 100vh;
              background: var(--bg-primary);
              padding: 40px 20px;
              display: flex;
              flex-direction: column;
              align-items: center;
            }
            header {
              text-align: center;
              margin-bottom: 32px;
            }
            h1 {
              font-size: 48px;
              color: var(--text-primary);
              margin: 0;
              background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
            }
            header p {
              color: var(--text-muted);
              font-size: 18px;
              margin-top: 8px;
            }
            .action-buttons {
              display: flex;
              gap: 12px;
              margin-bottom: 24px;
              flex-wrap: wrap;
              justify-content: center;
            }
            .action-btn {
              display: flex;
              align-items: center;
              gap: 8px;
              padding: 12px 20px;
              background: var(--bg-secondary);
              border: 1px solid var(--border-color);
              border-radius: 8px;
              color: var(--text-primary);
              text-decoration: none;
              font-size: 14px;
              transition: all 0.2s;
            }
            .action-btn:hover {
              border-color: var(--accent-primary);
              transform: translateY(-2px);
            }
            .search-section {
              display: flex;
              gap: 12px;
              width: 100%;
              max-width: 500px;
              margin-bottom: 40px;
            }
            .search-section input {
              flex: 1;
              padding: 14px 16px;
              background: var(--bg-secondary);
              border: 1px solid var(--border-color);
              border-radius: 8px;
              color: var(--text-primary);
              font-size: 14px;
            }
            .search-section input:focus {
              outline: none;
              border-color: var(--accent-primary);
            }
            .search-section button {
              padding: 14px 24px;
              background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
              border: none;
              border-radius: 8px;
              color: white;
              font-size: 14px;
              font-weight: bold;
              cursor: pointer;
            }
            .search-section button:hover {
              opacity: 0.9;
            }
            .demo {
              background: var(--bg-secondary);
              padding: 24px 32px;
              border-radius: 16px;
              max-width: 600px;
              width: 100%;
              margin-bottom: 40px;
            }
            .demo h2 {
              color: var(--text-primary);
              margin: 0 0 8px 0;
              font-size: 18px;
            }
            .demo p {
              color: var(--text-muted);
              margin: 0 0 16px 0;
            }
            .input-group {
              display: flex;
              gap: 12px;
            }
            .input-group input {
              flex: 1;
              padding: 12px 16px;
              background: var(--bg-primary);
              border: 1px solid var(--border-color);
              border-radius: 8px;
              color: var(--text-primary);
              font-size: 16px;
            }
            .input-group input:focus {
              outline: none;
              border-color: var(--accent-primary);
            }
            .input-group button {
              padding: 12px 24px;
              background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
              border: none;
              border-radius: 8px;
              color: white;
              font-size: 16px;
              font-weight: bold;
              cursor: pointer;
            }
            .demo-agents {
              margin-top: 16px;
              display: flex;
              flex-wrap: wrap;
              gap: 8px;
              align-items: center;
            }
            .demo-label {
              color: var(--text-muted);
              font-size: 12px;
            }
            .demo-btn {
              padding: 6px 12px;
              background: var(--bg-primary);
              border: 1px solid var(--border-color);
              border-radius: 6px;
              color: var(--text-muted);
              font-size: 12px;
              font-weight: normal;
              cursor: pointer;
            }
            .demo-btn:hover {
              border-color: var(--accent-primary);
              color: var(--text-primary);
            }
            .demo-btn.danger {
              border-color: var(--danger);
              color: var(--danger);
            }
            .demo-btn.danger:hover {
              background: rgba(239, 68, 68, 0.2);
            }
            .featured {
              width: 100%;
              max-width: 800px;
              margin-bottom: 40px;
            }
            .featured h2 {
              color: var(--text-primary);
              font-size: 20px;
              margin: 0 0 20px 0;
              text-align: center;
            }
            .agents-grid {
              display: grid;
              grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
              gap: 16px;
            }
            .loading {
              color: var(--text-muted);
              text-align: center;
              grid-column: 1 / -1;
            }
            .agent-card {
              background: var(--bg-secondary);
              border: 1px solid var(--border-color);
              border-radius: 12px;
              padding: 20px;
              text-decoration: none;
              transition: all 0.2s;
            }
            .agent-card:hover {
              border-color: var(--accent-primary);
              transform: translateY(-2px);
            }
            .agent-header {
              display: flex;
              justify-content: space-between;
              align-items: center;
              margin-bottom: 16px;
            }
            .agent-name {
              color: var(--text-primary);
              font-size: 14px;
              font-family: monospace;
            }
            .agent-stats {
              display: flex;
              justify-content: space-between;
            }
            .stat {
              text-align: center;
            }
            .stat .value {
              display: block;
              color: var(--text-primary);
              font-size: 16px;
              font-weight: bold;
            }
            .stat .label {
              color: var(--text-muted);
              font-size: 11px;
            }
            .add-agent-card {
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              background: transparent;
              border: 2px dashed var(--border-color);
              border-radius: 12px;
              padding: 40px;
              text-decoration: none;
              color: var(--text-muted);
              transition: all 0.2s;
              min-height: 120px;
            }
            .add-agent-card:hover {
              border-color: var(--accent-primary);
              color: var(--accent-primary);
            }
            .add-agent-card .plus {
              font-size: 32px;
              margin-bottom: 8px;
            }
            .stats {
              display: flex;
              gap: 24px;
              align-items: center;
              margin-bottom: 40px;
            }
            .stat-item {
              text-align: center;
            }
            .stat-item .value {
              display: block;
              color: var(--text-primary);
              font-size: 24px;
              font-weight: bold;
            }
            .stat-item .label {
              color: var(--text-muted);
              font-size: 12px;
            }
            .stat-divider {
              color: var(--border-color);
            }
            footer {
              margin-top: auto;
              color: var(--text-muted);
              font-size: 12px;
              text-align: center;
            }
            .footer-links {
              margin-top: 8px;
            }
            .footer-links a {
              color: var(--accent-primary);
              text-decoration: none;
            }
            .footer-links a:hover {
              text-decoration: underline;
            }
          `}</style>
        </main>
  );
}
