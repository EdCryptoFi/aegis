'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { getAllAgents, formatVolume, AgentInfo } from '../../lib/sdk';
import { AgentListSkeleton } from '../../components/Skeleton';

function getTrustLevel(agent: AgentInfo): string {
  if (agent.reputation.isFlagged) return 'FLAGGED';
  const successRate = agent.reputation.totalExecutions > 0
    ? (agent.reputation.successfulExecutions / agent.reputation.totalExecutions) * 100 : 100;
  if (successRate >= 95 && agent.reputation.totalExecutions >= 50) return 'HIGH';
  if (successRate >= 80 && agent.reputation.totalExecutions >= 10) return 'MEDIUM';
  return 'LOW';
}

function getTrustColor(level: string): string {
  switch (level) {
    case 'HIGH': return '#22c55e';
    case 'MEDIUM': return '#eab308';
    case 'LOW': return '#f97316';
    case 'FLAGGED': return '#ef4444';
    default: return '#888';
  }
}

export default function AgentsPage() {
  const [agents, setAgents] = useState<AgentInfo[]>([]);
  const [loading, setLoading] = useState(true);
  const [sortBy, setSortBy] = useState<'uptime' | 'volume' | 'executions'>('uptime');
  const [searchTerm, setSearchTerm] = useState('');
  const [filterTrust, setFilterTrust] = useState<'all' | 'High' | 'Medium' | 'Low' | 'Flagged'>('all');
  const [minExecutions, setMinExecutions] = useState(0);

  useEffect(() => {
    loadAgents();
  }, []);

  async function loadAgents() {
    setLoading(true);
    const data = await getAllAgents();
    setAgents(data);
    setLoading(false);
  }

  const filteredAgents = agents
    .filter(a => {
      if (searchTerm && !a.objectId.toLowerCase().includes(searchTerm.toLowerCase()) &&
          !a.agentId.toLowerCase().includes(searchTerm.toLowerCase())) return false;
      if (filterTrust !== 'all' && a.stats.trustLevel !== filterTrust) return false;
      if (a.reputation.totalExecutions < minExecutions) return false;
      return true;
    })
    .sort((a, b) => {
      switch (sortBy) {
        case 'uptime': return b.reputation.uptimeScore - a.reputation.uptimeScore;
        case 'volume': return b.reputation.totalVolume - a.reputation.totalVolume;
        case 'executions': return b.reputation.totalExecutions - a.reputation.totalExecutions;
        default: return 0;
      }
    });

  return (
    <main className="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 px-4 py-8">
      <div className="max-w-6xl mx-auto">
        <header className="mb-8">
          <Link href="/" className="text-indigo-400 hover:text-indigo-300 text-sm mb-4 inline-block">← Back to Home</Link>
          <h1 className="text-3xl font-bold text-white mb-2">Registered Agents</h1>
          <p className="text-slate-400">Explore all agents registered on Aegis</p>
        </header>

      <section className="bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-xl p-4 mb-6">
        <div className="flex flex-wrap gap-3 mb-4">
          <input
            type="text"
            placeholder="Search by address..."
            value={searchTerm}
            onChange={(e) => setSearchTerm(e.target.value)}
            className="flex-1 min-w-[200px] px-4 py-2.5 bg-slate-800/80 border border-slate-600 rounded-lg text-slate-200 text-sm focus:outline-none focus:border-indigo-500"
          />
          <select value={filterTrust} onChange={(e) => setFilterTrust(e.target.value as any)} className="px-4 py-2.5 bg-slate-800/80 border border-slate-600 rounded-lg text-slate-200 text-sm focus:outline-none focus:border-indigo-500">
            <option value="all">All Trust Levels</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
            <option value="Flagged">Flagged</option>
          </select>
          <select value={minExecutions} onChange={(e) => setMinExecutions(Number(e.target.value))} className="px-4 py-2.5 bg-slate-800/80 border border-slate-600 rounded-lg text-slate-200 text-sm focus:outline-none focus:border-indigo-500">
            <option value={0}>Any executions</option>
            <option value={10}>10+ executions</option>
            <option value={50}>50+ executions</option>
            <option value={100}>100+ executions</option>
            <option value={200}>200+ executions</option>
          </select>
        </div>
        <div className="flex justify-between items-center">
          <div className="flex gap-2">
            <span className="text-slate-500 text-sm">Sort by:</span>
            <button className={`px-3 py-1 rounded text-xs ${sortBy === 'uptime' ? 'bg-indigo-500 text-white' : 'bg-slate-700 text-slate-300'}`} onClick={() => setSortBy('uptime')}>Uptime</button>
            <button className={`px-3 py-1 rounded text-xs ${sortBy === 'volume' ? 'bg-indigo-500 text-white' : 'bg-slate-700 text-slate-300'}`} onClick={() => setSortBy('volume')}>Volume</button>
            <button className={`px-3 py-1 rounded text-xs ${sortBy === 'executions' ? 'bg-indigo-500 text-white' : 'bg-slate-700 text-slate-300'}`} onClick={() => setSortBy('executions')}>Executions</button>
          </div>
          <div className="text-slate-400 text-sm">{filteredAgents.length} / {agents.length} agents</div>
        </div>
      </section>

      {loading ? (
        <AgentListSkeleton />
      ) : (
        <section className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredAgents.map((agent, i) => {
            const level = getTrustLevel(agent);
            const successRate = agent.reputation.totalExecutions > 0
              ? Math.round((agent.reputation.successfulExecutions / agent.reputation.totalExecutions) * 100) : 100;
            return (
              <Link href={`/agent/${agent.objectId}`} key={agent.objectId} className="bg-slate-800/80 border border-slate-700 rounded-xl p-4 hover:border-indigo-500 hover:bg-slate-700/80 transition-all duration-200">
                <div className="flex justify-between items-start mb-3">
                  <span className="text-indigo-400 text-sm font-mono">{agent.objectId.slice(0, 8)}...{agent.objectId.slice(-4)}</span>
                  <span className="px-2 py-0.5 rounded text-xs font-semibold text-white" style={{ backgroundColor: getTrustColor(level) }}>{level}</span>
                </div>
                <div className="grid grid-cols-3 gap-2 text-center">
                  <div className="bg-slate-900/50 rounded p-2">
                    <div className="text-slate-500 text-xs">Uptime</div>
                    <div className="text-white font-semibold">{agent.reputation.uptimeScore}%</div>
                  </div>
                  <div className="bg-slate-900/50 rounded p-2">
                    <div className="text-slate-500 text-xs">Success</div>
                    <div className="text-white font-semibold">{successRate}%</div>
                  </div>
                  <div className="bg-slate-900/50 rounded p-2">
                    <div className="text-slate-500 text-xs">Volume</div>
                    <div className="text-white font-semibold text-xs">{formatVolume(agent.reputation.totalVolume)}</div>
                  </div>
                </div>
              </Link>
            );
          })}
</section>
      )}
      </div>
    </main>
  );
}
