# Public Sui Network Configuration
NEXT_PUBLIC_ENV=testnet
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_PACKAGE_ID=0x6472bb19be1908b8c948169c5627e625e54419b10138519e1caf5be4502d9e7d
NEXT_PUBLIC_BADGE_REGISTRY=0xd7f704c15109a42a56b74e962745831af33fb05cece15103b928bc7d9bd4adb3
NEXT_PUBLIC_MEMWAL_RELAYER_URL=https://relayer.staging.memwal.ai
NEXT_PUBLIC_MEMWAL_NAMESPACE=aegis

# Server-only: Groq API Key (get free at https://console.groq.com)
# Llama-3-8b-8192 is free to use
# NEVER expose this in NEXT_PUBLIC_ variables
GROQ_API_KEY=your_groq_api_key_here

# Server-only: Demo wallet private key (hex, with or without 0x prefix)
# Used by the CLI Walkthrough to register real agents on testnet.
# The wallet needs testnet SUI for gas. Get some at https://faucet.sui.io/
# Generate: sui keytool generate ed25519
DEMO_WALLET_PRIVATE_KEY=